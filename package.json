{
  "name": "ai-notebook",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:ext": "vite build",
    "build:notebook": "cd notebook && vite build",
    "build": "npm run build:ext && npm run build:notebook",

    "dev": "vite build --watch",
    "dev:server": "ts-node-dev --respawn server.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^25.6.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}